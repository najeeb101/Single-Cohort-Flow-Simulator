# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets / local env (keep .env.example committed) ----
.env
.env.local
.env.*.local

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Claude Code ----
# Keep the shared project settings; ignore personal/local state.
.claude/*
!.claude/settings.json
.claude/settings.local.json

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*~

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Project-specific ----
# outputs/figures/ stays COMMITTED: report/report_v2.md embeds those PNGs so it renders on GitHub.
# outputs/reports/ is regenerated raw data (CSV + the 16k-line flow_timeline.json) embedded
# nowhere — keep it out of history. web/ gets the same shape live from POST /simulate, not this file.
outputs/reports/
# Machine-specific benchmark timings (scripts/profile_run.py output) — no consumer reads the
# committed copy (profile_run.py has no --compare), and tracking it makes every run show up as a
# diff on every machine. Generate it locally when you need it.
outputs/profiling/benchmark_baseline.json
data/app.db
data/app.db-journal
data/app.db-wal
data/app.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
