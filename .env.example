# Copy this file to `.env` (which is gitignored) and fill in your values.
# The backend loads it automatically at startup (src/env.py). Real environment
# variables still win over anything set here.

# --- Advisor chat (Phase B, optional) ---------------------------------------------------
# Set LLM_API_KEY to enable the conversational advisor on the /advisor page. Leave it unset
# and the feature stays dormant (the rules-based advisor still works). Any OpenAI-compatible
# provider works. The defaults target Groq's free tier.
LLM_API_KEY=

# Defaults if omitted: Groq's OpenAI-compatible endpoint + a capable free model.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# Other providers are a pure config swap, e.g.:
#   Google Gemini (OpenAI-compatible):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.0-flash
#   OpenRouter:
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#   Anthropic via a compatibility proxy:
#     LLM_BASE_URL=...
#     LLM_MODEL=claude-...

# --- Other backend knobs (optional) -----------------------------------------------------
# DATABASE_URL=sqlite:///data/app.db
# CORS_ORIGINS=http://localhost:3000
