# Copy this file to `.env` (which is gitignored) and fill in your values.
# The backend loads it automatically at startup (src/env.py). Real environment
# variables still win over anything set here.

# --- Advisor chat (optional) ------------------------------------------------------------
# The AI never produces the intake number (the simulation does); it explains the result and
# proposes changes to test. Leave everything below unset and the chat stays off — the
# rules-based advice on the Advisor page still works.
#
# Recommended: a LOCAL model through Ollama (https://ollama.com). Free, works offline, and
# nothing leaves this PC. No API key needed for a localhost server.
#   ollama pull qwen3-coder:30b        (strongest; ~19 GB)
#   ollama pull qwen3:4b-instruct-2507-q4_K_M   (lighter; ~2.5 GB)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3-coder:30b
# LLM_TIMEOUT=120          # seconds; local inference is slower than a hosted API

# Optional paid/hosted model, used only if the local server isn't running (or make it the
# primary by setting LLM_BASE_URL / LLM_MODEL / LLM_API_KEY above instead). It receives only
# aggregate plan and result numbers, never student records. Any OpenAI-compatible provider:
#   Groq:        https://api.groq.com/openai/v1           llama-3.3-70b-versatile
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.0-flash
#   OpenRouter:  https://openrouter.ai/api/v1
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_API_KEY=

# --- Intake Planner (optional) ----------------------------------------------------------
# INTAKE_WORKERS=8         # CPU cores an analysis may use (default: all of them)

# --- Other backend knobs (optional) -----------------------------------------------------
# DATABASE_URL=sqlite:///data/app.db
# CORS_ORIGINS=http://localhost:3000
